APP_NAME="BugWatcher Pings"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8473

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Matches docker-compose.yml. Hosted PostgreSQL usually needs DB_SSLMODE=require.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bugwatcher_pings
DB_USERNAME=bugwatcher_pings
DB_PASSWORD=change-me
DB_SSLMODE=prefer
DB_SEARCH_PATH=public

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
# Redis, so queue workers keep running (and spooling) while the database is down.
CACHE_STORE=redis

# REDIS_URL takes precedence over the host settings when set (use rediss:// for TLS).
REDIS_CLIENT=predis
REDIS_URL=
REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

QUEUE_CONNECTION=redis

# "reverb" locally (php artisan reverb:start), "pusher" in production.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=bugwatcher-local
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="alerts@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Origin(s) of the web app, comma-separated. Used for CORS.
FRONTEND_URL=http://localhost:5473
SANCTUM_EXPIRATION=10080

# Signs the 5-minute tokens the dashboard uses to subscribe to WebSocket channels. At least 32 characters,
# e.g. the output of: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
# Bearer secret for POST /api/cron/run (the GitHub Actions maintenance workflow). Empty disables the endpoint.
CRON_SECRET=

# Error ingestion. The cache store must be shared by every API instance (Redis in production).
PINGS_CACHE_STORE=redis
PINGS_KEY_CACHE_TTL=60
PINGS_KEY_CACHE_NEGATIVE_TTL=30
PINGS_RATE_LIMIT_PER_KEY=300
PINGS_RATE_LIMIT_PER_IP=300
PINGS_QUEUE=ingest
PINGS_RETENTION_DAYS=30
PINGS_MAX_SPOOL_CYCLES=10
# Docker image only: queue workers started next to the web server.
QUEUE_WORKERS=1

DEMO_LOGIN_ENABLED=true
