APP_NAME="BugWatcher Pings"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8473

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Matches docker-compose.yml. Hosted PostgreSQL usually needs DB_SSLMODE=require.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bugwatcher_pings
DB_USERNAME=bugwatcher_pings
DB_PASSWORD=change-me
DB_SSLMODE=prefer
DB_SEARCH_PATH=public

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
CACHE_STORE=database

# REDIS_URL takes precedence over the host settings when set (use rediss:// for TLS).
REDIS_CLIENT=predis
REDIS_URL=
REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

QUEUE_CONNECTION=redis

# "reverb" locally (php artisan reverb:start), "pusher" in production.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=bugwatcher-local
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="alerts@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Origin(s) of the web app, comma-separated. Used for CORS.
FRONTEND_URL=http://localhost:5473
SANCTUM_EXPIRATION=10080

JWT_SECRET=
CRON_SECRET=
DEMO_LOGIN_ENABLED=true
